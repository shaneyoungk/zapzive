PORT=3001
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Wallet-approved USDC rail
# Testnet uses the public chain RPC defaults unless an HTTPS endpoint is set.
# Live USDC is deliberately disabled until all of these production controls are set.
CRYPTO_ENABLE_MAINNET=false
CRYPTO_PERSISTENT_STORAGE=false
# CRYPTO_BASE_SEPOLIA_RPC_URL=https://your-testnet-rpc.example
# CRYPTO_POLYGON_AMOY_RPC_URL=https://your-testnet-rpc.example
# CRYPTO_ETHEREUM_SEPOLIA_RPC_URL=https://your-testnet-rpc.example
# CRYPTO_ARBITRUM_SEPOLIA_RPC_URL=https://your-testnet-rpc.example
# CRYPTO_OPTIMISM_SEPOLIA_RPC_URL=https://your-testnet-rpc.example
# CRYPTO_ETHEREUM_RPC_URL=https://primary-ethereum-rpc.example
# CRYPTO_ETHEREUM_RPC_URL_SECONDARY=https://independent-ethereum-rpc.example
# CRYPTO_ARBITRUM_RPC_URL=https://primary-arbitrum-rpc.example
# CRYPTO_ARBITRUM_RPC_URL_SECONDARY=https://independent-arbitrum-rpc.example
# CRYPTO_OPTIMISM_RPC_URL=https://primary-optimism-rpc.example
# CRYPTO_OPTIMISM_RPC_URL_SECONDARY=https://independent-optimism-rpc.example
# CRYPTO_BASE_RPC_URL=https://primary-base-rpc.example
# CRYPTO_BASE_RPC_URL_SECONDARY=https://independent-base-rpc.example
# CRYPTO_POLYGON_RPC_URL=https://primary-polygon-rpc.example
# CRYPTO_POLYGON_RPC_URL_SECONDARY=https://independent-polygon-rpc.example
# Use one of these only on the protected scheduler, never in the frontend.
# CRYPTO_WORKER_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# CRON_SECRET=replace-with-a-random-secret-at-least-32-characters-long
