PORT=3001
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Wallet-approved EVM rail
# These public RPCs make the local testnet configuration work immediately.
# They are rate-limited shared infrastructure and are not production HA providers.
# Live payments remain deliberately disabled until persistent storage, dedicated
# RPC providers, worker authentication, and operational controls are configured.
CRYPTO_ENABLE_MAINNET=false
CRYPTO_PERSISTENT_STORAGE=false
# For a local or long-running backend, reconcile signed payments without an
# open browser. Vercel deployments should use CRON_SECRET instead.
CRYPTO_AUTOSTART_WORKER=false
CRYPTO_RECONCILIATION_INTERVAL_MS=15000

# Private local chain for hands-on wallet testing. Start it in its own terminal
# with `npm run devnet -- 0xYourWalletAddress`: it deploys test USDC, USDT and
# DAI and funds the address. Never offered in production or on Vercel.
CRYPTO_ENABLE_LOCAL_DEVNET=false
# CRYPTO_LOCAL_DEVNET_RPC_URL=http://127.0.0.1:8545

# Public testnet RPCs (usable for development and QA).
CRYPTO_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CRYPTO_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
CRYPTO_OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io
CRYPTO_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CRYPTO_POLYGON_AMOY_RPC_URL=https://polygon-amoy.publicnode.com

# ERC-20 contracts. USDC is configured in backend/src/crypto/config.ts from
# Circle's published testnet deployments. USDT uses 6 decimals; DAI uses 18.
# The testnet contracts below are third-party test tokens, not issuer-backed
# production funds. The API marks them as test tokens in the asset name.
# Sources: BlockATM testnet token registry, Push Base Sepolia token registry,
# LightPay Base Sepolia faucet, and Zama's Polygon Amoy registry.
CRYPTO_ETHEREUM_SEPOLIA_USDT_ADDRESS=0x0C556DFC43A1de7fDaAdC798e7AA0fd90E62f54E
CRYPTO_ETHEREUM_SEPOLIA_DAI_ADDRESS=0xf54cc6b8335a967fa932a2cef7859cf911cfc582
CRYPTO_ARBITRUM_SEPOLIA_USDT_ADDRESS=0x43bCA8Fe12a7888224a7e76ec938eD9a29800cE2
CRYPTO_ARBITRUM_SEPOLIA_DAI_ADDRESS=0x6B2576Ab5AAe6E479fb73611BcB2e4E71126FeAf
CRYPTO_OPTIMISM_SEPOLIA_USDT_ADDRESS=0x43bCA8Fe12a7888224a7e76ec938eD9a29800cE2
CRYPTO_OPTIMISM_SEPOLIA_DAI_ADDRESS=0xc70fbcebcaa4c877c18d80af62f42534bd18eb6d
CRYPTO_BASE_SEPOLIA_USDT_ADDRESS=0x4D7646B9eE3D68F4b0F135B5cbc66B00819F6b61
CRYPTO_BASE_SEPOLIA_DAI_ADDRESS=0xa8604da1a67b922e7c1777b96e5969b83ef833a3
CRYPTO_POLYGON_AMOY_USDT_ADDRESS=0x164F5A056166d8F2ce09FdAc6d040209a8C94d01
CRYPTO_POLYGON_AMOY_DAI_ADDRESS=0xD6247DbAe87797d86b4f43a218a015e2f34fD35a

# Public mainnet RPCs for smoke tests only. Replace both values per chain with
# separate authenticated providers before enabling mainnet. Do not use the
# same provider in both slots: the secondary is used for independent checks.
CRYPTO_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
CRYPTO_ETHEREUM_RPC_URL_SECONDARY=https://eth.drpc.org
CRYPTO_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
CRYPTO_ARBITRUM_RPC_URL_SECONDARY=https://arbitrum-one.publicnode.com
CRYPTO_OPTIMISM_RPC_URL=https://mainnet.optimism.io
CRYPTO_OPTIMISM_RPC_URL_SECONDARY=https://optimism-rpc.publicnode.com
CRYPTO_BASE_RPC_URL=https://mainnet.base.org
CRYPTO_BASE_RPC_URL_SECONDARY=https://base-rpc.publicnode.com
CRYPTO_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
CRYPTO_POLYGON_RPC_URL_SECONDARY=https://polygon.publicnode.com

# Official Ethereum mainnet token contracts (public addresses; live mode is
# still gated). Tether documents the USDT address; Sky documents the DAI one.
CRYPTO_ETHEREUM_USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
CRYPTO_ETHEREUM_DAI_ADDRESS=0x6B175474E89094C44Da98b954EedeAC495271d0F

# Mainnet L2 token contracts. These are chain-specific bridged/native
# deployments and are not interchangeable with Ethereum's contracts.
CRYPTO_ARBITRUM_USDT_ADDRESS=0xfd086bc7cd5c481dcc9c85ebe478a1c0b69fcbb9
CRYPTO_ARBITRUM_DAI_ADDRESS=0xda10009cbd5d07dd0cecc66161fc93d7c9000da1
CRYPTO_OPTIMISM_USDT_ADDRESS=0x94b008aa00579c1307b0ef2c499ad98a8ce58e58
CRYPTO_OPTIMISM_DAI_ADDRESS=0xda10009cbd5d07dd0cecc66161fc93d7c9000da1
CRYPTO_BASE_USDT_ADDRESS=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2
CRYPTO_BASE_DAI_ADDRESS=0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb
CRYPTO_POLYGON_USDT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
CRYPTO_POLYGON_DAI_ADDRESS=0x8f3Cf7ad23Cd3CaDbD9735AFf958023239c6A063

# Optional first-party sandbox asset deployment. Never put the deployer key
# into this file or expose it to the frontend. Set it only in a local secret
# store, then run `npm run deploy:test-assets` from backend. The script deploys
# non-upgradeable Zapzive test ERC-20 contracts, mints test balances, and writes
# only their public contract addresses into backend/.env.
# CRYPTO_TESTNET_DEPLOYER_PRIVATE_KEY=0x...
# CRYPTO_TESTNET_DEPLOYER_NETWORKS=ethereum-sepolia,arbitrum-sepolia,optimism-sepolia,base-sepolia,polygon-amoy
# CRYPTO_TESTNET_MINT_TO=0x...
# CRYPTO_TESTNET_MINT_AMOUNT=100000

# Use one of these only on the protected scheduler, never in the frontend.
# CRYPTO_WORKER_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# CRON_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Bitcoin and Solana are not represented by the EVM rail. Do not add their
# symbols as ERC-20 addresses; they require separate address validation,
# signing, fee estimation, confirmation, and reconciliation adapters.
