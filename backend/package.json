{
    "name": "zapzive-backend",
    "version": "1.0.0",
    "description": "Backend API for the Zapzive application",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
        "build": "prisma generate && tsc",
        "build:vercel": "prisma generate && prisma db push --skip-generate && tsc",
        "start": "node dist/server.js",
        "crypto:worker": "tsx src/crypto/run-worker.ts",
        "crypto:reconcile": "tsx src/crypto/run-worker.ts --once",
        "test:crypto": "tsx --test tests/crypto.test.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:seed": "tsx prisma/seed.ts",
        "prisma:studio": "prisma studio"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "keywords": [
        "zapzive",
        "api",
        "backend"
    ],
    "author": "",
    "license": "MIT",
    "engines": {
        "node": ">=18 <24"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-validator": "^7.2.1",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "viem": "2.56.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.10.5",
        "nodemon": "^3.1.11",
        "prisma": "^5.22.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
