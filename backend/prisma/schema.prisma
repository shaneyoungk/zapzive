// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  password        String
  role            String    @default("owner")
  status          String    @default("active")
  emailVerifiedAt DateTime?
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  authVersion     Int       @default(0)
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Company {
  id              String           @id @default(uuid())
  name            String
  email           String
  phone           String?
  country         String
  address         String?
  isTestMode      Boolean          @default(true)
  status          String           @default("active")
  liveEnabledAt   DateTime?
  users           User[]
  apiKeys         ApiKey[]
  webhooks        Webhook[]
  usageMetrics    UsageMetric[]
  transactions    Transaction[]
  remittances     Remittance[]
  recipients      Recipient[]
  workers         Worker[]
  payrollBatches  PayrollBatch[]
  assets          Asset[]
  swaps           Swap[]
  contracts       Contract[]
  agents          Agent[]
  complianceItems ComplianceItem[]
  idempotencyKeys IdempotencyKey[]
  auditEvents     AuditEvent[]
  cryptoWallets   CryptoWallet[]
  cryptoChallenges CryptoWalletChallenge[]
  cryptoPayments  CryptoPayment[]
  payoutRuns      PayoutRun[]
  movements       Movement[]
  approvals       Approval[]
  approvalPolicy  ApprovalPolicy?
  fundingAccounts FundingAccount[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model UsageMetric {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  type      String // api_call, webhook_sent
  count     Int      @default(0)
  timestamp DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  type        String // payroll, remittance, escrow, deposit, withdrawal, swap
  description String
  amount      Float
  currency    String   @default("USDC")
  isIncoming  Boolean
  status      String // pending, processing, settled, failed
  timestamp   DateTime @default(now())
  fees        Float?
  chain       String?
  txHash      String?
  metadata    String? // JSON string for additional data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Remittance {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  sender           String
  recipientId      String
  recipient        Recipient @relation(fields: [recipientId], references: [id])
  recipientCountry String
  amount           Float
  currency         String    @default("USDC")
  localAmount      Float
  localCurrency    String
  fxRate           Float
  fee              Float
  deliveryMethod   String // wallet, bank, mobile-money, cash-agent
  status           String // pending, processing, completed, failed
  createdDate      DateTime  @default(now())
  completedDate    DateTime?
  txHash           String?
  chain            String?
  agentLocation    String?
  pickupCode       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  note             String?
}

model Recipient {
  id            String       @id @default(uuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  name          String
  email         String?
  phone         String
  country       String
  walletAddress String?
  walletNetwork String? // evm or tron; required context for a wallet payout address
  bankAccount   String?
  mobileNumber  String?
  remittances   Remittance[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Worker {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  name        String
  role        String
  email       String
  phone       String
  country     String
  wallet      String
  bankAccount String?
  kycStatus   String // verified, pending, failed
  lastPayment DateTime?
  totalPaid   Float            @default(0)
  avatar      String?
  payments    PayrollPayment[]
  // Payout-operations recipient fields. The table keeps its storage name; the product calls these "recipients".
  recipientType    String    @default("contractor") // contractor, vendor, creator, freelancer, supplier, business
  status           String    @default("active") // active, archived
  payoutMethod     String? // mpesa, bank, mobile_money, usdc_wallet
  payoutCurrency   String?
  payoutDetails    String? // JSON: { phone } | { bankName, accountNumber, bankCode } | { walletAddress }
  detailsUpdatedAt DateTime?
  verifiedAt       DateTime?
  isSample         Boolean   @default(false)
  movements        Movement[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([companyId, email])
}

model PayrollBatch {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  name          String
  workerCount   Int
  totalAmount   Float
  status        String // draft, pending, approved, processing, completed
  createdDate   DateTime         @default(now())
  scheduledDate DateTime?
  completedDate DateTime?
  payments      PayrollPayment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PayrollPayment {
  id        String       @id @default(uuid())
  batchId   String
  batch     PayrollBatch @relation(fields: [batchId], references: [id])
  workerId  String
  worker    Worker       @relation(fields: [workerId], references: [id])
  amount    Float
  currency  String       @default("USDC")
  status    String // pending, processing, completed, failed
  txHash    String?
  chain     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Asset {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  symbol    String
  name      String
  balance   Float
  usdValue  Float
  change24h Float
  chain     String
  color     String
  icon      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, symbol])
}

model Swap {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  fromAsset  String
  toAsset    String
  fromAmount Float
  toAmount   Float
  rate       Float
  fee        Float
  status     String // pending, completed, failed
  txHash     String?
  chain      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Contract {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id])
  title           String
  description     String?
  client          String
  contractor      String
  totalAmount     Float
  lockedAmount    Float
  releasedAmount  Float       @default(0)
  status          String // draft, active, completed, disputed, cancelled
  startDate       DateTime
  endDate         DateTime
  chain           String
  contractAddress String?
  isPublic        Boolean     @default(false)
  views           Int         @default(0)
  milestones      Milestone[]
  bids            ContractBid[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model ContractBid {
  id             String   @id @default(uuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id])
  contractorName String
  contractorEmail String
  proposal       String
  amount         Float
  status         String   // pending, accepted, rejected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Milestone {
  id            String    @id @default(uuid())
  contractId    String
  contract      Contract  @relation(fields: [contractId], references: [id])
  title         String
  description   String
  amount        Float
  status        String // pending, in-progress, completed, disputed
  dueDate       DateTime
  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Agent {
  id                    String             @id @default(uuid())
  companyId             String
  company               Company            @relation(fields: [companyId], references: [id])
  name                  String
  location              String
  country               String
  status                String // active, inactive, pending
  rating                Float              @default(0)
  totalPayouts          Float              @default(0)
  completedTransactions Int                @default(0)
  pendingPayouts        Float              @default(0)
  phone                 String
  email                 String
  joinedDate            DateTime           @default(now())
  transactions          AgentTransaction[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([companyId, email])
}

model AgentTransaction {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  type      String // payout, commission
  amount    Float
  status    String // pending, completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComplianceItem {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  type      String // kyc, aml, sanctions, transaction
  entity    String
  status    String // approved, pending, flagged, rejected
  riskLevel String // low, medium, high
  date      DateTime @default(now())
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  key       String    @unique
  environment String  @default("test")
  scopes    String    @default("[\"read\",\"write\"]")
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Webhook {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  url       String
  events    String // JSON array of event types
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  key            String
  method         String
  path           String
  requestHash    String
  state          String   @default("processing") // processing, completed, failed
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([companyId, key])
  @@index([companyId, createdAt])
}

model AuditEvent {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String?
  requestId  String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

// On-chain records use integer base-unit strings. Crypto wallets are verified
// external addresses; balances are read from the selected network RPC and are
// never copied into the company Asset ledger.
model CryptoWallet {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  chainId   Int
  address   String
  createdBy String
  createdAt DateTime @default(now())
  payments  CryptoPayment[]

  // Ownership is proven per workspace, so one wallet may be linked to several.
  @@unique([companyId, chainId, address])
  @@index([companyId])
}

model CryptoWalletChallenge {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String
  chainId   Int
  address   String
  message   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([companyId, userId, createdAt])
}

model CryptoPayment {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  walletId      String
  wallet        CryptoWallet @relation(fields: [walletId], references: [id])
  createdBy     String
  chainId       Int
  tokenAddress  String
  symbol        String   @default("USDC")
  decimals      Int      @default(6)
  fromAddress   String
  toAddress     String
  amountUnits   String
  reference     String?
  idempotencyKey String
  payloadHash   String
  status        String   @default("awaiting_signature")
  txHash        String?
  nonce         Int?
  createdBlock  String
  blockNumber   String?
  blockHash     String?
  confirmations Int      @default(0)
  errorCode     String?
  version       Int      @default(0)
  attempts      Int      @default(0)
  nextCheckAt   DateTime @default(now())
  leaseUntil    DateTime?
  leaseOwner    String?
  expiresAt     DateTime
  settledAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  submissions   CryptoSubmission[]
  journals      CryptoJournal[]

  @@unique([companyId, idempotencyKey])
  @@unique([chainId, txHash])
  @@unique([chainId, fromAddress, nonce])
  @@index([companyId, createdAt, id])
  @@index([status, nextCheckAt, leaseUntil])
}

// Retain every submitted/replacement hash; never recycle a chain transaction.
model CryptoSubmission {
  id        String @id @default(uuid())
  paymentId String
  payment   CryptoPayment @relation(fields: [paymentId], references: [id])
  chainId   Int
  txHash    String
  nonce     Int
  createdAt DateTime @default(now())

  @@unique([chainId, txHash])
}

// Observational double-entry journal: a verified external wallet payment,
// not a claim that Zapzive holds the wallet's funds.
model CryptoJournal {
  id          String @id @default(uuid())
  paymentId   String
  payment     CryptoPayment @relation(fields: [paymentId], references: [id])
  kind        String // settlement or reversal
  createdAt   DateTime @default(now())
  entries     CryptoJournalEntry[]

  @@unique([paymentId, kind])
}

model CryptoJournalEntry {
  id           String @id @default(uuid())
  journalId    String
  journal      CryptoJournal @relation(fields: [journalId], references: [id])
  account      String
  amountUnits  String // signed integer; sum across a journal must be zero
}

// ---------------------------------------------------------------------------
// Payout operations. All money is stored as integer minor units.

model PayoutRun {
  id                String     @id @default(uuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id])
  reference         String // PR-1001
  name              String
  purpose           String?
  scheduledFor      DateTime?
  fundingCurrency   String     @default("USD")
  status            String     @default("draft") // draft, needs_correction, ready, awaiting_approval, approved, processing, completed, completed_with_failures, rejected, cancelled
  requiredApprovals Int        @default(0)
  policySummary     String?
  createdById       String
  createdByName     String
  submittedById     String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  executedAt        DateTime?
  completedAt       DateTime?
  reconciledAt      DateTime?
  reconciledById    String?
  cancelledAt       DateTime?
  isSample          Boolean    @default(false)
  movements         Movement[]
  approvals         Approval[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([companyId, reference])
  @@index([companyId, status])
}

model Movement {
  id                   String     @id @default(uuid())
  companyId            String
  company              Company    @relation(fields: [companyId], references: [id])
  runId                String?
  run                  PayoutRun? @relation(fields: [runId], references: [id])
  reference            String // MV-XXXXXXXX internal reference
  recipientId          String?
  recipient            Worker?    @relation(fields: [recipientId], references: [id])
  recipientName        String
  externalReference    String?
  amountMinor          Int // amount the recipient receives, in currency
  currency             String
  payoutMethod         String
  destination          String? // masked snapshot, e.g. "M-Pesa · +254 7•• ••• 123"
  country              String?
  sourceCurrency       String     @default("USD")
  sourceAmountMinor    Int? // cost in the funding currency, including fee
  feeMinor             Int? // in the funding currency
  fxRate               String? // destination units per 1 source unit, decimal string
  quotedAt             DateTime?
  quoteExpiresAt       DateTime?
  provider             String?
  rail                 String?
  providerReference    String?
  providerPayload      String? // JSON snapshot of the payout details actually sent to the provider
  state                String     @default("draft")
  validationIssues     String? // JSON array of { code, severity, message }
  acknowledgedIssues   String? // JSON array of acknowledged warning codes
  requiresApproval     Boolean    @default(false)
  exceptionType        String?
  failureReason        String?
  holdReason           String?
  attempt              Int        @default(1)
  deliveredAmountMinor Int?
  providerReadyAt      DateTime?
  submittedAt          DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  resolvedAt           DateTime?
  requestedById        String
  isSample             Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@unique([companyId, reference])
  @@index([companyId, state])
  @@index([runId])
  @@index([recipientId])
}

model Approval {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  runId        String
  run          PayoutRun @relation(fields: [runId], references: [id])
  actorId      String
  actorName    String
  decision     String // approved, rejected
  comment      String?
  selfApproval Boolean   @default(false)
  beforeStatus String
  afterStatus  String
  requestId    String?
  createdAt    DateTime  @default(now())

  @@index([runId])
}

model ApprovalPolicy {
  id                             String   @id @default(uuid())
  companyId                      String   @unique
  company                        Company  @relation(fields: [companyId], references: [id])
  currency                       String   @default("KES")
  singleApprovalAboveMinor       Int      @default(10000000) // KES 100,000
  dualApprovalAboveMinor         Int      @default(1000000000) // KES 10,000,000
  newRecipientRequiresApproval   Boolean  @default(true)
  changedDetailsRequiresApproval Boolean  @default(true)
  allowSelfApproval              Boolean  @default(true)
  updatedById                    String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model FundingAccount {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  currency       String   @default("USD")
  availableMinor Int      @default(0)
  reservedMinor  Int      @default(0)
  isSandbox      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, currency])
}
